# Copy this file to .env and replace every placeholder before deployment.
POSTGRES_DB=doclense
POSTGRES_USER=doclense
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password

# Must use the same credentials as above. URL-encode special characters.
DATABASE_URL=postgresql+psycopg2://doclense:replace-with-a-long-url-safe-password@db:5432/doclense

# Generate a unique random value of at least 32 bytes.
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key

# Private B2 bucket credentials; required by the upload service.
B2_BUCKET_NAME=replace-with-your-private-bucket
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-005
B2_KEY_ID=replace-with-your-b2-key-id
B2_APPLICATION_KEY=replace-with-your-b2-application-key

# Exact browser origin and externally reachable API base URL (no trailing slash).
CORS_ORIGINS=https://app.example.com
VITE_API_URL=https://api.example.com

MAX_UPLOAD_SIZE_MB=50
FRONTEND_PORT=8080
BACKEND_PORT=8000
