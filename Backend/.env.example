# PostgreSQL connection string. Use postgresql://, postgres://, or
# postgresql+psycopg2:// and provide the production database through secrets.
DATABASE_URL=postgresql://user:password@localhost:5432/doclense

# Generate a random secret of at least 32 bytes.
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long

# Backblaze B2 S3-compatible API credentials (never commit real credentials).
B2_BUCKET_NAME=your-private-bucket
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=your-application-key-id
B2_APPLICATION_KEY=your-application-key

OPENROUTER_API_KEY=your-openrouter-api-key

# Comma-separated browser origins. Include the deployed frontend origin.
CORS_ORIGINS=http://localhost:5173

# Persistent path for ChromaDB in a container deployment.
CHROMA_PERSIST_DIRECTORY=database
MAX_UPLOAD_SIZE_MB=50

# Optional. If unset, pytesseract uses `tesseract` from PATH.
# TESSERACT_CMD=/usr/bin/tesseract
